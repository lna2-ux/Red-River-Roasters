<div class="container py-5">
  <h1 class="title is-2">Shopping Cart</h1>

  <% if @cart_items.any? %>
    <div class="box">
      <table class="table is-fullwidth is-striped is-hoverable">
        <thead>
          <tr>
            <th>Product</th>
            <th>Unit Price</th>
            <th>Quantity</th>
            <th>Line Total</th>
            <th>Remove</th>
          </tr>
        </thead>
        <tbody>
          <% @cart_items.each do |item| %>
            <% product = item[:product] %>
            <tr>
              <td>
                <%= link_to product.name, product_path(product) %>
              </td>
              <td>
                <%= number_to_currency(product.price) %>
              </td>
              <td>
                <%= form_with url: update_cart_item_path, method: :patch, local: true, class: "field is-grouped" do %>
                  <%= hidden_field_tag :product_id, product.id %>
                  <div class="control">
                    <%= number_field_tag :quantity, item[:quantity], min: 1, class: "input is-small", style: "width: 80px;" %>
                  </div>
                  <div class="control">
                    <%= submit_tag "Update", class: "button is-small is-info" %>
                  </div>
                <% end %>
              </td>
              <td>
                <%= number_to_currency(item[:line_total]) %>
              </td>
              <td>
                <%= button_to "Remove",
                              remove_cart_item_path(product_id: product.id),
                              method: :delete,
                              class: "button is-small is-danger is-light" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <div class="level mt-4">
        <div class="level-left">
          <%= link_to "Continue Shopping", products_path, class: "button is-light" %>
        </div>
        <div class="level-right">
          <div class="level-item">
            <p class="subtitle is-4 mb-0">
              Subtotal: <strong><%= number_to_currency(@subtotal) %></strong>
            </p>
          </div>
          <div class="level-item">
            <%= link_to "Proceed to Checkout", new_order_path, class: "button is-primary" %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="notification is-light">
      <p>Your shopping cart is currently empty.</p>
    </div>
    <%= link_to "Browse Products", products_path, class: "button is-primary" %>
  <% end %>
</div>