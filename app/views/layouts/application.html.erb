<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? yield(:title) : "Red River Roasters | Winnipeg Specialty Coffee" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <style>
      html, body {
        min-height: 100vh;
        color: #2c1e16;
        background-color: #f6efe6;
        background-image:
          radial-gradient(rgba(184, 93, 25, 0.1) 1.5px, transparent 1.5px),
          linear-gradient(160deg, #f6efe6 0%, #e8d8c3 100%);
        background-size: 24px 24px, 100% 100%;
      }
      .title {
        display: block !important;
        line-height: 1.3 !important;
        margin-bottom: 1rem !important;
      }
      .subtitle {
        display: block !important;
        line-height: 1.55 !important;
        margin-top: 0.35rem !important;
      }
      .store-hero {
        background: linear-gradient(135deg, #2c1e16 0%, #4a2c18 60%, #b85d19 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 30px 24px;
        margin-bottom: 24px;
        box-shadow: 0 8px 20px rgba(44, 30, 22, 0.22);
      }
      .store-hero .title {
        color: #ffffff !important;
        margin-bottom: 0.75rem !important;
      }
      .store-hero .subtitle {
        color: #f8f5f0 !important;
        margin-bottom: 0 !important;
      }
      .product-card {
        background-color: #ffffff;
        border-radius: 6px;
        box-shadow: 0 4px 14px rgba(44, 30, 22, 0.14);
        border: 1px solid rgba(44, 30, 22, 0.12);
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .product-card .product-card-title {
        display: block;
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.35;
        margin-bottom: 0.45rem;
      }
      .product-card .product-card-title a {
        color: #2c1e16;
      }
      .product-card .product-card-price {
        display: block;
        font-size: 1.05rem;
        font-weight: 700;
        color: #b85d19;
        margin-bottom: 0.65rem;
      }
      .product-card .product-card-desc {
        display: block;
        font-size: 0.9rem;
        line-height: 1.45;
        color: #4a4a4a;
      }
    </style>
  </head>
  <body>
    <%= render "shared/navbar" %>

    <main class="section">
      <div class="container">
        <%= render "shared/flash" %>
        <%= render "shared/breadcrumbs" if lookup_context.exists?("shared/breadcrumbs") %>
        <%= yield %>
      </div>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>