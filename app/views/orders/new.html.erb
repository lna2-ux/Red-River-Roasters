<% content_for :title, "Checkout | Red River Roasters" %>

<h1 class="title is-2">Checkout</h1>

<% if flash[:alert].present? %>
  <div class="notification is-danger is-light"><%= flash[:alert] %></div>
<% end %>

<div class="columns">
  <div class="column is-7">
    <div class="box">
      <h2 class="title is-4">Customer &amp; Shipping Details</h2>

      <%= form_with url: orders_path, method: :post, local: true do %>
        <div class="field">
          <%= label_tag "customer_full_name", "Full Name", class: "label" %>
          <div class="control">
            <%= text_field_tag "customer[full_name]", @customer&.full_name, id: "customer_full_name", class: "input", required: true %>
          </div>
        </div>

        <div class="field">
          <%= label_tag "customer_email", "Email Address", class: "label" %>
          <div class="control">
            <%= email_field_tag "customer[email]", @customer&.email, id: "customer_email", class: "input", required: true %>
          </div>
        </div>

        <div class="field">
          <%= label_tag "customer_street_address", "Street Address", class: "label" %>
          <div class="control">
            <%= text_field_tag "customer[street_address]", @customer&.street_address, id: "customer_street_address", class: "input", required: true %>
          </div>
        </div>

        <div class="columns">
          <div class="column is-6">
            <div class="field">
              <%= label_tag "customer_city", "City", class: "label" %>
              <div class="control">
                <%= text_field_tag "customer[city]", @customer&.city || "Winnipeg", id: "customer_city", class: "input", required: true %>
              </div>
            </div>
          </div>

          <div class="column is-6">
            <div class="field">
              <%= label_tag "customer_postal_code", "Postal Code", class: "label" %>
              <div class="control">
                <%= text_field_tag "customer[postal_code]", @customer&.postal_code, id: "customer_postal_code", class: "input", required: true %>
              </div>
            </div>
          </div>
        </div>

        <div class="field">
          <%= label_tag "order_province_id", "Province / Territory", class: "label" %>
          <div class="control">
            <div class="select is-fullwidth">
              <%= select_tag "order[province_id]",
                    options_from_collection_for_select(Array(@provinces), :id, :name, @default_province&.id),
                    id: "order_province_id" %>
            </div>
          </div>
        </div>

        <div class="field mt-5">
          <div class="buttons">
            <%= link_to "Back to Cart", cart_path, class: "button is-light" %>
            <%= submit_tag "Place Order", class: "button is-warning" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="column is-5">
    <div class="box">
      <h2 class="title is-4">Order Summary</h2>

      <table class="table is-fullwidth">
        <thead>
          <tr>
            <th>Item</th>
            <th>Qty</th>
            <th class="has-text-right">Total</th>
          </tr>
        </thead>
        <tbody>
          <% Array(@cart_items).each do |item| %>
            <tr>
              <td><%= item[:product].name %></td>
              <td><%= item[:quantity] %></td>
              <td class="has-text-right"><%= number_to_currency(item[:line_total]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <hr>

      <p class="is-flex is-justify-content-space-between mb-2">
        <span>Subtotal</span>
        <strong><%= number_to_currency(@subtotal) %></strong>
      </p>
      <% if @tax_breakdown %>
        <p class="is-flex is-justify-content-space-between mb-1">
          <span>Estimated GST</span>
          <span><%= number_to_currency(@tax_breakdown[:gst_amount]) %></span>
        </p>
        <p class="is-flex is-justify-content-space-between mb-1">
          <span>Estimated PST</span>
          <span><%= number_to_currency(@tax_breakdown[:pst_amount]) %></span>
        </p>
        <p class="is-flex is-justify-content-space-between mb-2">
          <span>Estimated HST</span>
          <span><%= number_to_currency(@tax_breakdown[:hst_amount]) %></span>
        </p>
      <% end %>
      <hr>
      <p class="title is-5 is-flex is-justify-content-space-between">
        <span>Estimated Total</span>
        <span><%= number_to_currency(@total) %></span>
      </p>
    </div>
  </div>
</div>