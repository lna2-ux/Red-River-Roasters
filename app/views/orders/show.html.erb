<% content_for :title, "Order ##{@order.id} | Red River Roasters" %>

<div class="level mb-4">
  <div class="level-left">
    <div>
      <h1 class="title is-2 mb-1">Order Confirmation #<%= @order.id %></h1>
      <p class="subtitle is-6 has-text-grey">
        Placed on <%= @order.created_at.strftime("%B %d, %Y at %I:%M %p") %> · Status: <strong><%= @order.status.to_s.capitalize %></strong>
      </p>
    </div>
  </div>
  <div class="level-right">
    <%= link_to "Continue Shopping", products_path, class: "button is-warning" %>
  </div>
</div>

<div class="columns">
  <div class="column is-5">
    <div class="box">
      <h2 class="title is-5">Customer &amp; Shipping Details</h2>
      <p><strong>Name:</strong> <%= @order.customer&.full_name %></p>
      <p><strong>Email:</strong> <%= @order.customer&.email %></p>
      <p><strong>Address:</strong> <%= @order.customer&.street_address %></p>
      <p>
        <strong>City / Province:</strong>
        <%= [@order.customer&.city, @order.province&.name].compact_blank.join(", ") %>
      </p>
      <p><strong>Postal Code:</strong> <%= @order.customer&.postal_code %></p>
    </div>
  </div>

  <div class="column is-7">
    <div class="box">
      <h2 class="title is-5">Order Summary</h2>

      <table class="table is-fullwidth is-striped">
        <thead>
          <tr>
            <th>Item</th>
            <th>Unit Price</th>
            <th>Qty</th>
            <th class="has-text-right">Line Total</th>
          </tr>
        </thead>
        <tbody>
          <% @order.order_items.each do |item| %>
            <tr>
              <td><%= item.product_name.presence || item.product&.name %></td>
              <td><%= number_to_currency(item.unit_price) %></td>
              <td><%= item.quantity %></td>
              <td class="has-text-right"><%= number_to_currency(item.line_total) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <hr>

      <p class="is-flex is-justify-content-space-between mb-1">
        <span>Subtotal</span>
        <strong><%= number_to_currency(@order.subtotal) %></strong>
      </p>
      <p class="is-flex is-justify-content-space-between mb-1">
        <span>GST (<%= number_to_percentage(@order.gst_rate.to_d * 100, precision: 2) %>)</span>
        <span><%= number_to_currency(@order.gst_amount) %></span>
      </p>
      <p class="is-flex is-justify-content-space-between mb-1">
        <span>PST (<%= number_to_percentage(@order.pst_rate.to_d * 100, precision: 2) %>)</span>
        <span><%= number_to_currency(@order.pst_amount) %></span>
      </p>
      <p class="is-flex is-justify-content-space-between mb-2">
        <span>HST (<%= number_to_percentage(@order.hst_rate.to_d * 100, precision: 2) %>)</span>
        <span><%= number_to_currency(@order.hst_amount) %></span>
      </p>
      <hr>
      <p class="title is-5 is-flex is-justify-content-space-between">
        <span>Total Paid</span>
        <span><%= number_to_currency(@order.total_amount) %></span>
      </p>
    </div>
  </div>
</div>